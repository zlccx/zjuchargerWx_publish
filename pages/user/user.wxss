.user-container {
    padding-top: 30rpx;
    min-height: 100vh;
    background-color: #f5f5f5;
    position: relative;
}

.version-tag {
    margin: 10rpx 20rpx;
    font-size: 24rpx;
    color: #999;
    background-color: #fff;
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.first_line {
    display: flex;
    align-items: center;
    margin: 0 20rpx 20rpx;
}

.first_line .sort-btn {
    margin: 10rpx 0 10rpx auto; 
    font-size: 28rpx;
    color: #1aad19;
    padding: 20rpx;
    background-color: #f0f9ff;
    border-radius: 8rpx;
}

.first_line .station-tip {
    margin: 10rpx auto 10rpx 0; 
    font-size: 28rpx;
    color: #666;
    padding: 20rpx;
    text-align: center;
    border-radius: 10rpx;
}

/* 用户页面内容 */
.user-content {
    padding: 0 20rpx 20rpx;
}

/* 空收藏状态 */
.empty-container {
    text-align: center;
    padding: 100rpx 0;
    background-color: #fff;
    border-radius: 10rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.empty-text {
    font-size: 32rpx;
    color: #666;
    margin-bottom: 20rpx;
}

/* 收藏列表 */
.station-list {
}

/* 加载状态 */
.loading {
    text-align: center;
    padding: 50rpx 0;
    font-size: 28rpx;
    color: #1aad19;
}

/* 版本公告弹窗 */
.announcement-mask {
    position: fixed;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}

.announcement-card {
    width: 80vw;
    max-height: 70vh;
    background-color: #fff;
    border-radius: 24rpx;
    padding: 40rpx 36rpx 30rpx;
    box-sizing: border-box;
    overflow-y: auto;
}

.announcement-header {
    display: flex;
    align-items: baseline;
    justify-content: center;
    margin-bottom: 30rpx;
}

.announcement-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #1a1a1a;
}

.announcement-version {
    margin-left: 16rpx;
    font-size: 26rpx;
    color: #1aad19;
}

.announcement-item {
    margin-bottom: 26rpx;
}

.announcement-item-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}

.announcement-item-desc {
    font-size: 26rpx;
    color: #666;
    line-height: 1.6;
}

.announcement-btn {
    margin-top: 20rpx;
    padding: 22rpx 0;
    text-align: center;
    background-color: #1aad19;
    color: #fff;
    border-radius: 16rpx;
    font-size: 30rpx;
}

.announcement-btn:active {
    opacity: 0.85;
}